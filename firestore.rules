rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /orders/{orderId} {
      // Public visitors may submit a constrained order. They cannot read, edit, or delete orders.
      // For a public production store, add Firebase App Check and consider a server-side order endpoint.
      allow create: if
        request.resource.data.keys().hasAll([
          'gameKey', 'gameName', 'offerId', 'offerName', 'playerId',
          'playerExtra', 'customerName', 'currency', 'priceSdg',
          'priceLabel', 'language', 'status', 'source', 'createdAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'gameKey', 'gameName', 'offerId', 'offerName', 'playerId',
          'playerExtra', 'customerName', 'currency', 'priceSdg',
          'priceLabel', 'language', 'status', 'source', 'createdAt'
        ]) &&
        request.resource.data.gameKey is string &&
        request.resource.data.gameKey in ['freefire', 'pubg', 'mlbb', 'codm'] &&
        request.resource.data.gameName is string &&
        request.resource.data.gameName.size() <= 60 &&
        request.resource.data.offerId is string &&
        request.resource.data.offerId.size() <= 80 &&
        request.resource.data.offerName is string &&
        request.resource.data.offerName.size() <= 100 &&
        request.resource.data.playerId is string &&
        request.resource.data.playerId.size() >= 1 &&
        request.resource.data.playerId.size() <= 80 &&
        request.resource.data.playerExtra is string &&
        request.resource.data.playerExtra.size() <= 120 &&
        request.resource.data.customerName is string &&
        request.resource.data.customerName.size() <= 80 &&
        request.resource.data.currency == 'SDG' &&
        (request.resource.data.priceSdg == null ||
          (request.resource.data.priceSdg is number && request.resource.data.priceSdg >= 0)) &&
        request.resource.data.priceLabel is string &&
        request.resource.data.priceLabel.size() <= 50 &&
        request.resource.data.language in ['ar', 'en'] &&
        request.resource.data.status == 'new' &&
        request.resource.data.source == 'katshr-web' &&
        request.resource.data.createdAt is string &&
        request.resource.data.createdAt.size() <= 40;

      allow read, update, delete: if false;
    }
  }
}
